{
  "$defs": {
    "AuthorManifest": {
      "description": "Автор проекта (профиль; см. tz-02 §3.2).",
      "properties": {
        "email": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "initials": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "default": "human",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`rde.toml` — манифест проекта.",
  "properties": {
    "authors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuthorManifest"
      },
      "type": "array"
    },
    "default_rebuild": {
      "default": "manual",
      "type": "string"
    },
    "default_template": {
      "default": "",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "network_allow": {
      "default": false,
      "description": "Сеть разрешена артефактам проекта по умолчанию (R-RUN-06; артефакт может переопределить).",
      "type": "boolean"
    },
    "schema": {
      "type": "string"
    },
    "trusted": {
      "default": false,
      "description": "Проект доверенный: пользователь дал согласие на запуск скриптов (R-RUN-06).",
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "id",
    "name"
  ],
  "title": "ProjectManifest",
  "type": "object"
}