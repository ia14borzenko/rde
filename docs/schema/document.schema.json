{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`document.toml` — манифест документа.",
  "properties": {
    "file": {
      "description": "Рабочий файл документа (в M3 — `.doc.rde`, пока `.docx`).",
      "type": "string"
    },
    "formula_numbering": {
      "default": "continuous",
      "description": "Схема нумерации формул документа (ADR-0018): `continuous` (сквозная, по умолчанию) или\n`section` (по разделам, ГОСТ `(2.1)`; приложения `(А.1)`). Номер — документно-локальный\n(ADR-0005 §3.1), назначается RDE, а не набирается руками.",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "template": {
      "default": "",
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "file"
  ],
  "title": "DocumentManifest",
  "type": "object"
}