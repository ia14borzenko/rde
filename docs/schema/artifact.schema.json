{
  "$defs": {
    "ConstantValue": {
      "description": "Значение константы проекта (тип `constants`, R-ART-09).",
      "properties": {
        "display": {
          "default": "",
          "type": "string"
        },
        "format": {
          "description": "Формат отображения значения: `auto|raw|int|dec:N|sci:N|percent:N` (R-DOC-11).",
          "type": "string"
        },
        "source": {
          "description": "Источник значения (R-ART-09, ADR-0005): URI выхода артефакта\n`rde://artifact/<id>[@<out_hash>]/<selector>`; при заданном `source` значение разрешается\nиз артефакта, а `value` — кэш последнего разрешённого значения.",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "default": "",
          "description": "Подсказка форматирования (например, `italic-subscript` для `R_н`).",
          "type": "string"
        },
        "subscript": {
          "description": "Подстрочный индекс обозначения (R-DOC-23), например `н` в `R_н`.",
          "type": "string"
        },
        "symbol": {
          "description": "Обозначение величины (R-DOC-23): базовая буква; курсив обеспечивается `style`.",
          "type": "string"
        },
        "unit": {
          "default": "",
          "type": "string"
        },
        "value": {
          "description": "Литерал значения ИЛИ кэш последнего разрешённого значения при заданном `source`.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "GroupManifest": {
      "description": "Группа зависимостей артефакта (`hashed` — влияет на хеш/каскад, `ref` — только provenance).",
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InputSpec"
          },
          "type": "array"
        },
        "mode": {
          "default": "hashed",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "InputSpec": {
      "anyOf": [
        {
          "description": "Выход другого артефакта; `selector` — относительный путь или glob (`out/*.csv`).",
          "properties": {
            "artifact": {
              "type": "string"
            },
            "selector": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "artifact"
          ],
          "type": "object"
        },
        {
          "description": "Файл данных внутри каталога артефакта (`inputs/data.csv`).",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "required": [
            "note"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "description": "Типизированные константы проекта (артефакт `type = \"constants\"`).\n`selector` — имя конкретной величины; пусто — весь набор значений.",
          "properties": {
            "constants": {
              "type": "string"
            },
            "selector": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "constants"
          ],
          "type": "object"
        }
      ],
      "description": "Вход артефакта: ссылка на выход другого артефакта, файл, заметка, источник или константы."
    },
    "RuntimeManifest": {
      "description": "Окружение исполнения скрипта артефакта.",
      "properties": {
        "entry": {
          "description": "Относительный путь к исполняемому файлу артефакта.",
          "type": "string"
        },
        "env": {
          "default": "project",
          "description": "Режим окружения: `project` (uv/pnpm/pixi), `system` или `artifact`.",
          "type": "string"
        },
        "kind": {
          "description": "`python` | `shell` | `node` | `r`.",
          "type": "string"
        },
        "vars": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Объявленные переменные окружения (входят в `env_hash`, tz-02 §7.2).",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "entry"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`artifact.toml` — манифест артефакта (`compute`, `data` или `constants`).",
  "properties": {
    "groups": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GroupManifest"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "network_allow": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "out_hash": {
      "description": "`out_hash` последнего успешного обновления (идентичность выходов, tz-02 §7.3 п.10).\nПишется RDE после успешного обновления; отсутствует до первого запуска.",
      "type": [
        "string",
        "null"
      ]
    },
    "outputs": {
      "default": [],
      "description": "Объявленные выходы (относительные пути/glob внутри каталога артефакта).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "params": {
      "default": null,
      "description": "Произвольные параметры запуска (входят в `params_hash`)."
    },
    "rebuild": {
      "default": "",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "type": "string"
    },
    "script_files": {
      "default": [],
      "description": "Дополнительные файлы скрипта, входящие в `script_hash` (tz-02 §7.2, `extra_script_files`).\nПути относительно каталога артефакта; читаются вместе с `runtime.entry`.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "timeout_s": {
      "default": null,
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "type": {
      "description": "`compute` | `data` | `constants`.",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "$ref": "#/$defs/ConstantValue"
      },
      "default": {},
      "description": "Для `type = \"constants\"`: типизированные значения проекта.",
      "type": "object"
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "type"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}