Subject: [PATCH] =?UTF-8?q?RDE:=20layout:=20display-=D1=84=D0=BE=D1=80?=
 =?UTF-8?q?=D0=BC=D1=83=D0=BB=D0=B0=20=D0=B4=D0=B5=D0=BB=D0=B8=D1=82=20?=
 =?UTF-8?q?=D1=81=D1=82=D1=80=D0=BE=D0=BA=D1=83=20=D1=81=20=D1=82=D0=B0?=
 =?UTF-8?q?=D0=B1=D0=B0=D0=BC=D0=B8=20=D0=B8=20=D0=BD=D0=BE=D0=BC=D0=B5?=
 =?UTF-8?q?=D1=80=D0=BE=D0=BC=20(right-numbered)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

RDE вставляет display-формулу как абзац с таб-стопами (центр текста + правый край) и
номером (n) в конце строки — Word-стиль «Right-numbered» без невидимой таблицы 1×2
(ADR-0018). WordCraft уводил display-формулу на отдельную строку при любом содержимом
перед ней и разрывал строку после неё, поэтому номер оказывался на следующей строке.

Изменения (crates/layout/src/para.rs, break_lines):
- табы/маркеры перед display-формулой больше не уводят её на свою строку (прочий текст —
  по-прежнему уводит: семантика Word для абзаца с текстом и display-формулой);
- после display-формулы строка продолжается, если следующий элемент — таб: правый таб
  прижимает номер к правой границе текста.

Тест: tests::a_display_equation_shares_a_line_with_its_right_number (центр формулы на
центр-табе, конец строки у правого поля). Проверено: cargo test -p wordcraft-layout
(490 passed), clippy -D warnings, fmt --check; RDE: headless-скриншот DocView и
LO-оракул экспорта (номер (1) x≈537.9..552.9 pt при правом поле 552.5 pt).
---
 crates/layout/src/para.rs  | 11 ++++++++++-
 crates/layout/src/tests.rs | 38 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/crates/layout/src/para.rs b/crates/layout/src/para.rs
index 8e56aea8..58e4ccd6 100644
--- a/crates/layout/src/para.rs
+++ b/crates/layout/src/para.rs
@@ -2202,7 +2202,11 @@ fn break_lines(pl: &mut ParaLayout, env: &ParaEnv, mark_style: u32, level: Optio
             }
             // A display equation sits on a line of its own.
             let is_display = pl.displays.iter().any(|(ci, _)| *ci == j);
-            if is_display && (c0..j).any(|k| pl.clusters.get(k).is_some_and(|c| c.kind != ClKind::Marker)) {
+            // RDE: right-numbered формула — display-формула в абзаце с табуляциями (центр + право)
+            // и номером `(n)` в конце строки (Word «Right-numbered» без таблицы). Табы перед
+            // формулой не разрывают строку; прочий текст — по-прежнему уводит формулу на свою строку.
+            let only_tabs_before = (c0..j).all(|k| pl.clusters.get(k).is_some_and(|c| matches!(c.kind, ClKind::Marker | ClKind::Tab)));
+            if is_display && !only_tabs_before && (c0..j).any(|k| pl.clusters.get(k).is_some_and(|c| c.kind != ClKind::Marker)) {
                 end = LineEnd::Wrap;
                 break;
             }
@@ -2338,6 +2342,11 @@ fn break_lines(pl: &mut ParaLayout, env: &ParaEnv, mark_style: u32, level: Optio
                     xs.push(x);
                     j += 1;
                 }
+                // RDE: номер `(n)` справа — после display-формулы строка продолжается табом
+                // (right-numbered без таблицы); таб уводит номер к правой границе текста.
+                if j < n && pl.clusters.get(j).is_some_and(|c| c.kind == ClKind::Tab) {
+                    continue;
+                }
                 end = if j >= n { LineEnd::Para } else { LineEnd::Wrap };
                 break;
             }
diff --git a/crates/layout/src/tests.rs b/crates/layout/src/tests.rs
index 9fe3a510..dad77bf1 100644
--- a/crates/layout/src/tests.rs
+++ b/crates/layout/src/tests.rs
@@ -10688,3 +10688,41 @@ fn layout_cache_invalidates_on_changed_filepath() {
     let text_b = shown(&l_b);
     assert_eq!(text_b, "/path/two/a.docx", "second layout with same cache shows /path/two/a.docx");
 }
+
+/// RDE: display-формула в абзаце с табуляциями делит строку с номером — формула на центральном
+/// таб-стопе, номер `(1)` правым краем у правого таб-стопа (Word «Right-numbered» без таблицы;
+/// RDE ADR-0018). Раньше display-формула всегда уводилась на отдельную строку.
+#[test]
+fn a_display_equation_shares_a_line_with_its_right_number() {
+    use wordcraft_doc::props::{TabAlign, TabLeader, TabStop};
+    let text_width = 468.0f32;
+    let mut d = Document::from_text("");
+    let math = wordcraft_doc::math::Math { nodes: wordcraft_doc::math::parse_linear("a=b"), ..Default::default() };
+    let p = d.para_mut(StoryRef::Body, &Path::top(0)).unwrap();
+    p.insert_text(0, "\t\t(1)", &Default::default()).unwrap();
+    p.insert_object(1, InlineObject::Equation { linear: "a=b".into(), display: true, math }, &Default::default()).unwrap();
+    p.props.tabs = Some(vec![
+        TabStop { pos: text_width / 2.0, align: TabAlign::Center, leader: TabLeader::None },
+        TabStop { pos: text_width, align: TabAlign::Right, leader: TabLeader::None },
+    ]);
+    let l = lay(&d);
+    let (para, x) = l.pages[0]
+        .items
+        .iter()
+        .find_map(|it| match it {
+            Placed::Lines { para, x, .. } => Some((para, *x)),
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(para.lines.len(), 1, "формула и номер — в одной строке: {:?}", para.lines);
+    assert_eq!(para.displays.len(), 1, "формула осталась display: {:?}", para.displays);
+    let line = &para.lines[0];
+    // Кластеры: таб, формула-объект, таб, «(1)».
+    assert_eq!(line.c0, 0);
+    let formula = para.clusters.iter().position(|c| matches!(c.kind, crate::para::ClKind::Object(_))).expect("кластер формулы");
+    let formula_center = x + line.xs[formula] + para.clusters[formula].adv / 2.0;
+    assert!((formula_center - (x + text_width / 2.0)).abs() < 1.0, "формула по центру текста: {formula_center} vs {}", x + text_width / 2.0);
+    // Конец строки (правый край последнего кластера) — у правой границы текста.
+    let end = x + line.xs[line.c1 - line.c0];
+    assert!((end - (x + text_width)).abs() < 1.0, "номер прижат к правому полю: {end} vs {}", x + text_width);
+}
